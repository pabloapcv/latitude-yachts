# Required on Vercel only if OIDC is not enabled. Locally, set this to call a real model.
# On Vercel, enable OIDC (Settings → Security) so AI Gateway authenticates with VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# Optional. Defaults to google/gemini-3.5-flash-lite (small, cheap, fast).
AI_GATEWAY_MODEL=google/gemini-3.5-flash-lite

# Optional. Digits only with country code, no +. When empty, the bot never offers WhatsApp.
WHATSAPP_NUMBER=

# Set to 1 to skip the model and stream grounded mock replies (local tests / screenshots).
MOCK_CHAT=
